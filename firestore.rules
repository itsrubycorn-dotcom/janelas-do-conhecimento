rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SUBSTITUA o e-mail abaixo pelo e-mail que você criou no Firebase Authentication.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'SEU_EMAIL_ADMIN@EXEMPLO.COM'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function isAnonymous() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    match /visits/{visitId} {
      allow create: if isAnonymous()
        && request.resource.data.keys().hasOnly(['name','uid','visitedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.visitedAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /feedbacks/{feedbackId} {
      allow create: if isAnonymous()
        && request.resource.data.keys().hasOnly(['name','uid','rating','ease','comment','submittedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.ease in ['sim','parcialmente','nao']
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 2
        && request.resource.data.comment.size() <= 600
        && request.resource.data.submittedAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    // Negar todo o restante. Não existem registros públicos.
    match /{document=**} { allow read, write: if false; }
  }
}
